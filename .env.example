EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EAS project ID from `npx eas-cli@latest init`; never put service-role keys here.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Public key only. The matching private VAPID key belongs in Supabase Secrets.
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Optional: enables place search on the check-in form; map picking needs no key.
EXPO_PUBLIC_GEOAPIFY_API_KEY=
