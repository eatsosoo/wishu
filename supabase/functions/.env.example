# Only on the Supabase Edge Function, never in the Expo app.
GIFT_WORKER_SECRET=replace-with-a-long-random-secret
# Optional: enable enhanced push security in the Expo dashboard, then set this.
EXPO_ACCESS_TOKEN=
# Same public key as EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY on Vercel.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com
