{
  "expo": {
    "name": "Our Wish",
    "slug": "wishu",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ourwish",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "Cho phép Our Wish dùng vị trí để ghim nơi hai bạn đã đến." }],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Our Wish dùng camera để chụp ảnh check-in của hai bạn.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      ["expo-image-picker", { "cameraPermission": "Cho phép Our Wish dùng camera để chụp ảnh check-in của hai bạn.", "photosPermission": "Cho phép Our Wish chọn ảnh để lưu những kỷ niệm của hai bạn.", "microphonePermission": false }],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pacifico-Regular.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BB607D",
          "defaultChannel": "gifts"
        }
      ],
      "expo-image",
      "expo-asset"
    ]
  }
}
