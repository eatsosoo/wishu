{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate", "Service-Worker-Allowed": "/" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
